# The Extractor - Configuration File
# Copy or rename to config.yaml to customize your instance.

app:
  host: "127.0.0.1"
  port: 8000
  api_key: ""                 # Leave empty for localhost zero-config, or set a secure token. (Mandatory for non-localhost 0.0.0.0)
  cors_origins:
    - "http://127.0.0.1:8000"
    - "http://localhost:8000"

security:
  require_api_key_for_non_localhost: true
  max_url_length: 2048

paths:
  download_dir: "downloads"   # Path relative to workspace or absolute path
  data_dir: "data"
  cookies_file: ""            # Optional path to cookies.txt (e.g. "cookies.txt")
  audacity_path: ""           # Optional explicit path to Audacity executable (auto-detected if empty)

defaults:
  video_resolution: "best"    # Options: "best", "1080p", "720p", "480p"
  audio_format: "mp3"         # Options: "mp3", "wav", "m4a"
  audio_bitrate: "192"        # Options: "320", "192", "128" (kbps)
  download_video: true
  download_audio: true
  download_doc: true

processing:
  max_retries: 3              # Number of retries on transient network/YouTube errors
  retry_delay_seconds: 2
  max_concurrent_downloads: 2 # Queue worker concurrency
  max_batch_size: 100         # Max URLs per batch request (rejects larger batches)
  max_playlist_items: 500     # Max videos to expand from a playlist
  max_queue_size: 500         # Maximum pending tasks in queue
  task_retention_minutes: 10  # Automatically purge completed/failed task state from memory after N minutes

storage:
  max_storage_gb: 0.0         # Max storage for downloads/ (0.0 for unlimited, e.g. 10.0 for 10GB cap)
  delete_after_days: 0        # Auto-delete files older than N days (0 for never)
  warning_percent: 80.0       # Disk full warning threshold
  critical_percent: 95.0      # Hard disk protection: stop accepting new downloads

history:
  max_records: 10000          # Retention cap on total history database rows
  retention_days: 90          # Auto-purge history records older than N days
